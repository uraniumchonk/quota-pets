    "offline": {
      "img": "normal.png",
      "text": "連不到家裡的貓窩"
    }
  },
  "rules": [
    {
      "if": {
        "source": "offline"
      },
      "pose": "offline"
    },
    {
      "if": {
        "agentState": [
          "idle",
          "sleeping",
          "offline",
          "unknown"
        ],
        "idleSecAtLeast": 1800,
        "not": {
          "clickedWithinSec": 10
        }
      },
      "pose": "idle"
    },
    {
      "if": {
        "severity": "critical"
      },
      "pose": "critical"
    },
    {
      "if": {
        "agentState": "working"
      },
      "pose": "working"
    },
    {
      "if": {
        "severity": "warning"
      },
      "pose": "warning"
    },
    {
      "pose": "normal"
    }
  ],
  "click": {
    "say": true,
    "pose": null,
    "ms": 1500
  },
  "lines": {
    "normal": [
      "有事找我",
      "Grok 在這"
    ],
    "warning": [
      "快用完囉"
    ],
    "critical": [
      "用光光了",
      "下週見"
    ],
    "offline": [
      "連不上…"
    ],
    "working": [
      "查資料中",
      "忙著呢"
    ],
    "idle": [
      "（撐著臉發呆）"
    ]
  },
  "offset": {
    "x": 0,
    "y": 0
  }
