{
  "name": "Grok（哥德雙馬尾）",
  "size": {
    "w": 1448,
    "h": 1086
  },
  "scale": 1,
  "agent": "cli:grok",
  "quota": [
    {
      "provider": "grok",
      "window": "7d",
      "label": "週"
    }
  ],
  "footer": "reset",
  "textBox": {
    "x": 580,
    "y": 728,
    "w": 646,
    "h": 266,
    "rotate": 0,
    "fontSize": 46,
    "color": "#2f2a45"
  },
  "poses": {
    "normal": {
      "img": "normal.png"
    },
    "warning": {
      "img": "normal.png"
    },
    "critical": {
      "img": "normal.png"
    },
    "sleep": {
      "img": "normal.png",
      "text": "睡覺中 zzz"
    },
    "offline": {
      "img": "normal.png",
      "text": "連不到家裡的貓窩"
    }
  },
  "rules": [
    {
      "if": {
        "source": "offline"
      },
      "pose": "offline"
    },
    {
      "if": {
        "agentState": [
          "sleeping",
          "offline"
        ],
        "idleSecAtLeast": 1800,
        "not": {
          "clickedWithinSec": 10
        }
      },
      "pose": "sleep"
    },
    {
      "if": {
        "severity": "critical"
      },
      "pose": "critical"
    },
    {
      "if": {
        "severity": "warning"
      },
      "pose": "warning"
    },
    {
      "pose": "normal"
    }
  ],
  "click": {
    "say": true,
    "pose": null,
    "ms": 1500
  },
  "lines": {
    "normal": [
      "有事找我",
      "Grok 在這"
    ],
    "warning": [
      "快用完囉"
    ],
    "critical": [
      "用光光了",
      "下週見"
    ],
    "sleep": [
      "zzz…"
    ],
    "offline": [
      "連不上…"
    ]
  },
  "offset": {
    "x": 0,
    "y": 0
  }
}
