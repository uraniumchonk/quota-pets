        "zh-TW": "連不到家裡的貓窩",
        "en": "Can't reach the server"
      }
    }
  },
  "rules": [
    {
      "if": {
        "source": "offline"
      },
      "pose": "offline"
    },
    {
      "if": {
        "agentState": [
          "idle",
          "sleeping",
          "offline",
          "unknown"
        ],
        "idleSecAtLeast": 1800,
        "not": {
          "clickedWithinSec": 10
        }
      },
      "pose": "idle"
    },
    {
      "if": {
        "severity": "critical"
      },
      "pose": "critical"
    },
    {
      "if": {
        "agentState": "working"
      },
      "pose": "working"
    },
    {
      "if": {
        "severity": "warning"
      },
      "pose": "warning"
    },
    {
      "pose": "normal"
    }
  ],
  "click": {
    "say": true,
    "pose": null,
    "ms": 1500
  },
  "lines": {
    "normal": {
      "zh-TW": [
        "有事找我",
