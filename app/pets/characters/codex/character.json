{
  "name": "Codex（白龍）",
  "size": {
    "w": 1448,
    "h": 1086
  },
  "scale": 1,
  "agent": "cli:codex",
  "quota": [
    {
      "provider": "codex",
      "window": "7d",
      "label": "週"
    }
  ],
  "footer": "reset",
  "textBox": {
    "x": 246,
    "y": 744,
    "w": 590,
    "h": 250,
    "rotate": 0,
    "fontSize": 46,
    "color": "#2f2a45"
  },
  "poses": {
    "normal": {
      "img": "normal.png"
    },
    "warning": {
      "img": "normal.png"
    },
    "critical": {
      "img": "normal.png"
    },
    "sleep": {
      "img": "normal.png",
      "text": "睡覺中 zzz"
    },
    "offline": {
      "img": "normal.png",
      "text": "連不到家裡的貓窩"
    }
  },
  "rules": [
    {
      "if": {
        "source": "offline"
      },
      "pose": "offline"
    },
    {
      "if": {
        "agentState": [
          "sleeping",
          "offline"
        ],
        "idleSecAtLeast": 1800,
        "not": {
          "clickedWithinSec": 10
        }
      },
      "pose": "sleep"
    },
    {
      "if": {
        "severity": "critical"
      },
      "pose": "critical"
    },
    {
      "if": {
        "severity": "warning"
      },
      "pose": "warning"
    },
    {
      "pose": "normal"
    }
  ],
  "click": {
    "say": true,
    "pose": null,
    "ms": 1500
  },
  "lines": {
    "normal": [
      "要寫什麼？",
      "Codex 待命中"
    ],
    "warning": [
      "這週用了不少喔"
    ],
    "critical": [
      "這週沒了…",
      "等提前重置！"
    ],
    "sleep": [
      "zzz…"
    ],
    "offline": [
      "連不上…"
    ]
  },
  "offset": {
    "x": 0,
    "y": 0
  }
}
