  "footer": "reset",
  "textBox": {
    "x": 246,
    "y": 744,
    "w": 590,
    "h": 250,
    "rotate": 0,
    "fontSize": 46,
    "color": "#2f2a45"
  },
  "poses": {
    "normal": {
      "img": "normal.png"
    },
    "working": {
      "img": "01_working.png",
      "textBox": {
        "x": 242,
        "y": 736,
        "w": 586,
        "h": 256,
        "rotate": 0,
        "fontSize": 46,
        "color": "#2f2a45"
      }
    },
    "warning": {
      "img": "normal.png"
    },
    "critical": {
      "img": "02_quota_empty.png",
      "textBox": {
        "x": 248,
        "y": 744,
        "w": 588,
        "h": 250,
        "rotate": 0,
        "fontSize": 46,
        "color": "#2f2a45"
      }
    },
    "idle": {
      "img": "03_idle.png",
      "showQuota": false
    },
    "offline": {
      "img": "normal.png",
      "text": {
        "zh-TW": "連不到家裡的貓窩",
        "en": "Can't reach the server"
      }
    }
  },
  "rules": [
    {
      "if": {
        "source": "offline"
      },
      "pose": "offline"
    },
    {
      "if": {
        "agentState": [
          "idle",
          "sleeping",
          "offline",
          "unknown"
        ],
        "idleSecAtLeast": 1800,
        "not": {
          "clickedWithinSec": 10
        }
      },
      "pose": "idle"
    },
    {
      "if": {
        "severity": "critical"
      },
      "pose": "critical"
    },
    {
      "if": {
        "agentState": "working"
      },
      "pose": "working"
    },
    {
      "if": {
        "severity": "warning"
      },
      "pose": "warning"
    },
    {
      "pose": "normal"
    }
  ],
  "click": {
    "say": true,
    "pose": null,
    "ms": 1500
  },
  "lines": {
    "normal": {
      "zh-TW": [
        "要寫什麼？",
        "Codex 待命中"
      ],
      "en": [
        "What are we building?",
        "Codex standing by"
      ]
    },
    "warning": {
      "zh-TW": [
        "這週用了不少喔"
      ],
      "en": [
        "Used a lot this week"
      ]
    },
    "critical": {
      "zh-TW": [
        "這週沒了…",
        "等提前重置！"
      ],
      "en": [
        "Out for this week…",
        "Hoping for an early reset!"
      ]
    },
    "offline": {
      "zh-TW": [
        "連不上…"
      ],
      "en": [
        "Can't connect…"
      ]
    },
    "working": {
      "zh-TW": [
        "編譯中…",
        "跑測試中"
      ],
      "en": [
        "Compiling…",
        "Running tests"
      ]
    },
    "idle": {
      "zh-TW": [
        "zzz…"
      ],
      "en": [
        "zzz…"
      ]
    }
  },
  "offset": {
